# This file uses POSIX shell syntax because the deployment instructions export it.
# Copy it to .env.swarm on the VPS, replace all example values, and keep it private.

# Docker Swarm / host settings
ERP_IMAGE=erp-app:2026.09.13
ERP_STACK_NAME=catalogo-ventas
ERP_NETWORK=erp_backend
ERP_STORAGE_PATH=/srv/erp/storage
ERP_PUBLISHED_PORT=8585

# Laravel application
APP_NAME="ERP"
APP_KEY=base64:REPLACE_WITH_A_GENERATED_KEY
APP_URL=https://erp.example.com
MARKETING_BRAND_NAME="MetisHub ERP"
MARKETING_ANALYTICS_ENABLED=false
MARKETING_ANALYTICS_DOMAIN=
MARKETING_ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Existing MySQL instance. DB_HOST is its service name only when both services
# share ERP_NETWORK; otherwise use the private IP address or DNS name of MySQL.
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=maestro_panadero
DB_USERNAME=erp_user
DB_PASSWORD='REPLACE_WITH_A_STRONG_PASSWORD'

# Persistence and runtime. Database sessions/cache require their Laravel tables.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Readiness. Activa la conciliación estricta solo después de ejecutar
# `php artisan operations:reconcile --all --sync` correctamente.
OPERATIONS_READY_REQUIRE_RECONCILIATION=false
OPERATIONS_READY_MAX_RECONCILIATION_AGE=30
OPERATIONS_REQUIRED_RETRY_AFTER=960
